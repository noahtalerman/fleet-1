]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'org.godotengine.godot' && sudo rm -rf \"$APPDIR/Godot.app\" && sudo rm -rf 'godot' && trash $LOGGED_IN_USER '~/Library/Application Support/Godot' && trash $LOGGED_IN_USER '~/Library/Caches/Godot' && trash $LOGGED_IN_USER '~/Library/Saved Application State/org.godotengine.godot.savedState'",
