]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'com.lemonmojo.RoyalTSX.App' && sudo rm -rf \"$APPDIR/Royal TSX.app\" && trash $LOGGED_IN_USER '~/Library/Application Support/com.lemonmojo.RoyalTSX.App' && trash $LOGGED_IN_USER '~/Library/Application Support/Royal TSX' && trash $LOGGED_IN_USER '~/Library/Caches/com.lemonmojo.RoyalTSX.App' && trash $LOGGED_IN_USER '~/Library/Preferences/com.lemonmojo.RoyalTSX.App.plist'",
