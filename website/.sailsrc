            "description": "Process virtual root directory",
            "type": "text",
            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          },
          {
            "name": "uid",
            "description": "Unsigned user ID",
            "type": "bigint",
            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          },
          {
            "name": "gid",
            "description": "Unsigned group ID",
            "type": "bigint",
            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          },
          {
            "name": "euid",
            "description": "Unsigned effective user ID",
            "type": "bigint",
            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          },
          {
            "name": "egid",
            "description": "Unsigned effective group ID",
            "type": "bigint",
            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          },
          {
            "name": "suid",
            "description": "Unsigned saved user ID",
            "type": "bigint",
            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          },
          {
