"\"); print}'); INSTALL_LOCATION=$(echo \"$PKGINFO\" | awk '/<key>install-location<\\/key>/ {getline; gsub(/.*<string>|<\\/string>.*/, \"\"); print}'); if [ -z \"$INSTALL_LOCATION\" ] || [ \"$INSTALL_LOCATION\" = \"/\" ]; then FULL_INSTALL_LOCATION=\"$VOLUME\"; else FULL_INSTALL_LOCATION=\"$VOLUME/$INSTALL_LOCATION\"; FULL_INSTALL_LOCATION=$(echo \"$FULL_INSTALL_LOCATION\" | sed 's|//|/|g'); fi; echo \"sudo pkgutil --only-files --files \\\"$PKGID\\\" | sed \\\"s|^|${FULL_INSTALL_LOCATION}/|\\\" | tr '\\\\\\\\n' '\\\\\\\\0' | /usr/bin/sudo -u root -E -- /usr/bin/xargs -0 -- /bin/rm -rf\"; sudo pkgutil --only-files --files \"$PKGID\" | sed \"s|^|/${INSTALL_LOCATION}/|\" | tr '\\n' '\\0' | /usr/bin/sudo -u root -E -- /usr/bin/xargs -0 -- /bin/rm -rf; echo \"sudo pkgutil --only-dirs --files \\\"$PKGID\\\" | sed \\\"s|^|${FULL_INSTALL_LOCATION}/|\\\" | grep '\\\\.app$' | tr '\\\\\\\\n' '\\\\\\\\0' | /usr/bin/sudo -u root -E -- /usr/bin/xargs -0 -- /bin/rm -rf\"; sudo pkgutil --only-dirs --files \"$PKGID\" | sed \"s|^|${FULL_INSTALL_LOCATION}/|\" | grep '\\.app$' | tr '\\n' '\\0' | /usr/bin/sudo -u root -E -- /usr/bin/xargs -0 -- /bin/rm -rf; root_app_dir=$(; sudo pkgutil --only-dirs --files \"$PKGID\" \\; | sed \"s|^|${FULL_INSTALL_LOCATION}/|\" \\; | grep 'Applications' \\; | awk '{ print length, $0 }' \\; | sort -n \\; | head -n1 \\; | cut -d' ' -f2-; ); if [ -n \"$root_app_dir\" ]; then echo \"sudo rmdir -p \\\"$root_app_dir\\\" 2>/dev/null || :\"; sudo rmdir -p \"$root_app_dir\" 2>/dev/null || :; fi } && trash() { local logged_in_user=\"$1\"; local target_file=\"$2\"; local timestamp=\"$(date +%Y-%m-%d-%s)\"; local rand=\"$(jot -r 1 0 99999)\"; if [[ \"$target_file\" == ~* ]]; then target_file=\"/Users/$logged_in_user${target_file:1}\"; fi; local trash=\"/Users/$logged_in_user/.Trash\"; if [[ \"$target_file\" == *[*?[]* ]]; then local file file_name; local matched=false; local i=0; while IFS= read -r file; do [[ -n \"$file\" ]] || continue; [[ -e \"$file\" || -L \"$file\" ]] || continue; matched=true; i=$((i + 1)); file_name=\"$(basename \"$file\")\"; echo \"removing $file.\"; mv -f \"$file\" \"$trash/${file_name}_${timestamp}_${rand}_${i}\"; done < <(compgen -G \"$target_file\" 2>/dev/null) if [[ \"$matched\" == false ]]; then echo \"$target_file doesn't exist.\"; fi; return fi; local file_name=\"$(basename \"${target_file}\")\"; if [[ -e \"$target_file\" ]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'com.jabra.Avaya3Driver' && quit_application 'com.jabra.AvayaDriver' && quit_application 'com.jabra.BriaDriver' && quit_application 'com.jabra.directonline' && quit_application 'com.jabra.softphoneService' && quit_application 'nl.superalloy.oss.terminal-notifier' && remove_pkg_files 'com.jabra.directonline' && forget_pkg 'com.jabra.directonline' && remove_pkg_files 'com.jabra.JabraFirmwareUpdate' && forget_pkg 'com.jabra.JabraFirmwareUpdate' && remove_pkg_files 'com.jabra.kext' && forget_pkg 'com.jabra.kext' && sudo rm -rf '/Applications/Jabra Direct.app' && trash $LOGGED_IN_USER '~/Library/Application Support/Jabra Direct' && trash $LOGGED_IN_USER '~/Library/Application Support/Jabra' && trash $LOGGED_IN_USER '~/Library/Application Support/JabraSDK' && trash $LOGGED_IN_USER '~/Library/Logs/Jabra Direct' && trash $LOGGED_IN_USER '~/Library/Preferences/com.jabra.directonline.helper.plist' && trash $LOGGED_IN_USER '~/Library/Preferences/com.jabra.directonline.plist' && trash $LOGGED_IN_USER '~/Library/Preferences/com.jabra.prefsettings.plist' && trash $LOGGED_IN_USER '~/Library/Saved Application State/com.jabra.directonline.savedState'",
