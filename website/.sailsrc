      {
        "name": "AdGuard",
        "identifier": "adguard-darwin",
        "outputSlug": "adguard/darwin",
        "bundleIdentifier": "com.adguard.mac.adguard",
        "description": "AdGuard is a standalone ad blocker.",
        "platform": "darwin",
        "lineNumberInJson": 152,
