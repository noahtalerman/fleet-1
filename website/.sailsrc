            "type": "bigint",
            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          },
          {
            "name": "pgroup",
            "description": "Process group",
            "type": "bigint",
            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          },
          {
            "name": "threads",
            "description": "Number of threads used by process",
            "type": "integer",
            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          },
          {
            "name": "nice",
            "description": "Process nice level (-20 to 20, default 0)",
