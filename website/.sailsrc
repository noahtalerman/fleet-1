ile\" ]] || continue; matched=true; i=$((i + 1)); file_name=\"$(basename \"$file\")\"; echo \"removing $file.\"; mv -f \"$file\" \"$trash/${file_name}_${timestamp}_${rand}_${i}\"; done < <(compgen -G \"$target_file\" 2>/dev/null) if [[ \"$matched\" == false ]]; then echo \"$target_file doesn't exist.\"; fi; return fi; local file_name=\"$(basename \"${target_file}\")\"; if [[ -e \"$target_file\" ]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'io.tailscale.ipn.macsys' && remove_pkg_files 'com.tailscale.ipn.macsys' && forget_pkg 'com.tailscale.ipn.macsys' && sudo rm -rf '/usr/local/bin/tailscale' && sudo rm -rf '/usr/local/share/man/man8/tssentineld.8' && trash $LOGGED_IN_USER '/Library/Tailscale' && trash $LOGGED_IN_USER '~/Library/Application Scripts/*.io.tailscale.ipn.macsys' && trash $LOGGED_IN_USER '~/Library/Application Scripts/io.tailscale.ipn.macsys' && trash $LOGGED_IN_USER '~/Library/Application Scripts/io.tailscale.ipn.macsys.login-item-helper' && trash $LOGGED_IN_USER '~/Library/Application Scripts/io.tailscale.ipn.macsys.share-extension' && trash $LOGGED_IN_USER '~/Library/Caches/io.tailscale.ipn.macsys' && trash $LOGGED_IN_USER '~/Library/Containers/io.tailscale.ipn.macos.network-extension' && trash $LOGGED_IN_USER '~/Library/Containers/io.tailscale.ipn.macsys' && trash $LOGGED_IN_USER '~/Library/Containers/io.tailscale.ipn.macsys.login-item-helper' && trash $LOGGED_IN_USER '~/Library/Containers/io.tailscale.ipn.macsys.share-extension' && trash $LOGGED_IN_USER '~/Library/Containers/Tailscale' && trash $LOGGED_IN_USER '~/Library/Group Containers/*.io.tailscale.ipn.macsys' && trash $LOGGED_IN_USER '~/Library/HTTPStorages/io.tailscale.ipn.macsys' && trash $LOGGED_IN_USER '~/Library/HTTPStorages/io.tailscale.ipn.macsys.binarycookies' && trash $LOGGED_IN_USER '~/Library/Preferences/io.tailscale.ipn.macsys.plist'",
