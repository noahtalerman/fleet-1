]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'com.tradingview.tradingviewapp.desktop' && sudo rm -rf \"$APPDIR/TradingView.app\" && trash $LOGGED_IN_USER '~/Library/Application Support/TradingView' && trash $LOGGED_IN_USER '~/Library/Preferences/com.tradingview.tradingviewapp.desktop.plist' && trash $LOGGED_IN_USER '~/Library/Saved Application State/com.tradingview.tradingviewapp.desktop.savedState'",
