]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'net.hovancik.stretchly' && sudo rm -rf \"$APPDIR/Stretchly.app\" && trash $LOGGED_IN_USER '~/Library/Application Support/Stretchly' && trash $LOGGED_IN_USER '~/Library/Logs/Stretchly' && trash $LOGGED_IN_USER '~/Library/Preferences/net.hovancik.stretchly.plist'",
