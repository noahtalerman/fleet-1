]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'com.stonerl.Thaw' && quit_application 'com.stonerl.Thaw.MenuBarItemService' && sudo rm -rf \"$APPDIR/Thaw.app\" && trash $LOGGED_IN_USER '~/Library/Application Scripts/*.com.stonerl.Thaw' && trash $LOGGED_IN_USER '~/Library/Application Scripts/com.stonerl.Thaw.ThawControls' && trash $LOGGED_IN_USER '~/Library/Application Support/Thaw' && trash $LOGGED_IN_USER '~/Library/Caches/com.stonerl.Thaw' && trash $LOGGED_IN_USER '~/Library/Containers/com.stonerl.Thaw.ThawControls' && trash $LOGGED_IN_USER '~/Library/Group Containers/*.com.stonerl.Thaw' && trash $LOGGED_IN_USER '~/Library/HTTPStorages/com.stonerl.Thaw' && trash $LOGGED_IN_USER '~/Library/Logs/Thaw' && trash $LOGGED_IN_USER '~/Library/Preferences/com.stonerl.Thaw.plist' && trash $LOGGED_IN_USER '~/Library/WebKit/com.stonerl.Thaw'",
