        "description": "Retrieves statistics about queries that are scheduled on a device.",
        "query": "SELECT *,\n        (SELECT value from osquery_flags where name = 'pack_delimiter') AS delimiter\n      FROM osquery_schedule\n",
        "purpose": "Informational",
