        "lineNumberInJson": 5038,
        "iconFilename": "app-icon-little-snitch-60x60@2x.png",
        "uninstallScript": "APPDIR=\"/Applications/\" && LOGGED_IN_USER=$(scutil <<< \"show State:/Users/ConsoleUser\" | awk '/Name :/ { print $3 }') && quit_application() { local bundle_id=\"$1\"; local timeout_duration=10; local app_running; app_running=$(osascript -e \"application id \\\"$bundle_id\\\" is running\" 2>/dev/null); if [[ \"$app_running\" != \"true\" ]]; then return fi; local console_user; console_user=$(stat -f \"%Su\" /dev/console); if [[ -z \"$console_user\" || \"$console_user\" == \"root\" || \"$console_user\" == \"loginwindow\" ]]; then echo \"Not logged into a non-root GUI; skipping quitting application ID '$bundle_id'.\"; return fi; echo \"Quitting application '$bundle_id'...\"; local quit_success=false; SECONDS=0; while (( SECONDS < timeout_duration )); do if osascript -e \"tell application id \\\"$bundle_id\\\" to quit\" >/dev/null 2>&1; then if ! pgrep -f \"$bundle_id\" >/dev/null 2>&1; then echo \"Application '$bundle_id' quit successfully.\"; quit_success=true; break; fi; fi; sleep 1; done if [[ \"$quit_success\" = false ]]; then echo \"Application '$bundle_id' did not quit.\"; fi } && trash() { local logged_in_user=\"$1\"; local target_file=\"$2\"; local timestamp=\"$(date +%Y-%m-%d-%s)\"; local rand=\"$(jot -r 1 0 99999)\"; if [[ \"$target_file\" == ~* ]]; then target_file=\"/Users/$logged_in_user${target_file:1}\"; fi; local trash=\"/Users/$logged_in_user/.Trash\"; if [[ \"$target_file\" == *[*?[]* ]]; then local file file_name; local matched=false; local i=0; while IFS= read -r file; do [[ -n \"$file\" ]] || continue; [[ -e \"$file\" || -L \"$file\" ]] || continue; matched=true; i=$((i + 1)); file_name=\"$(basename \"$file\")\"; echo \"removing $file.\"; mv -f \"$file\" \"$trash/${file_name}_${timestamp}_${rand}_${i}\"; done < <(compgen -G \"$target_file\" 2>/dev/null) if [[ \"$matched\" == false ]]; then echo \"$target_file doesn't exist.\"; fi; return fi; local file_name=\"$(basename \"${target_file}\")\"; if [[ -e \"$target_file\" ]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'at.obdev.littlesnitch' && sudo rm -rf \"$APPDIR/Little Snitch.app\" && sudo rmdir '/Library/Application Support/Objective Development' && trash $LOGGED_IN_USER '/Library/Application Support/Objective Development/Little Snitch' && trash $LOGGED_IN_USER '/Library/Caches/at.obdev.LittleSnitchConfiguration' && trash $LOGGED_IN_USER '/Library/Extensions/LittleSnitch.kext' && trash $LOGGED_IN_USER '/Library/Little Snitch' && trash $LOGGED_IN_USER '/Library/Logs/LittleSnitchDaemon.log' && trash $LOGGED_IN_USER '/Library/StagedExtensions/Library/Extensions/LittleSnitch.kext' && trash $LOGGED_IN_USER '~/Library/Application Support/Little Snitch' && trash $LOGGED_IN_USER '~/Library/Caches/at.obdev.LittleSnitchAgent' && trash $LOGGED_IN_USER '~/Library/Caches/at.obdev.LittleSnitchConfiguration' && trash $LOGGED_IN_USER '~/Library/Caches/at.obdev.LittleSnitchHelper' && trash $LOGGED_IN_USER '~/Library/Caches/at.obdev.LittleSnitchSoftwareUpdate' && trash $LOGGED_IN_USER '~/Library/Caches/com.apple.helpd/Generated/at.obdev.LittleSnitchConfiguration.help*' && trash $LOGGED_IN_USER '~/Library/Caches/com.apple.helpd/SDMHelpData/Other/English/HelpSDMIndexFile/at.obdev.LittleSnitchConfiguration.help*' && trash $LOGGED_IN_USER '~/Library/Logs/Little Snitch Agent.log' && trash $LOGGED_IN_USER '~/Library/Logs/Little Snitch Helper.log' && trash $LOGGED_IN_USER '~/Library/Logs/Little Snitch Installer.log' && trash $LOGGED_IN_USER '~/Library/Logs/Little Snitch Network Monitor.log' && trash $LOGGED_IN_USER '~/Library/Preferences/at.obdev.LittleSnitchAgent.plist' && trash $LOGGED_IN_USER '~/Library/Preferences/at.obdev.LittleSnitchConfiguration.plist' && trash $LOGGED_IN_USER '~/Library/Preferences/at.obdev.LittleSnitchInstaller.plist' && trash $LOGGED_IN_USER '~/Library/Preferences/at.obdev.LittleSnitchNetworkMonitor.plist' && trash $LOGGED_IN_USER '~/Library/Preferences/at.obdev.LittleSnitchSoftwareUpdate.plist' && trash $LOGGED_IN_USER '~/Library/Saved Application State/at.obdev.LittleSnitchInstaller.savedState' && trash $LOGGED_IN_USER '~/Library/WebKit/at.obdev.LittleSnitchConfiguration'",
