]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'studio.techflow.badgeify' && sudo rm -rf \"$APPDIR/Badgeify.app\" && trash $LOGGED_IN_USER '~/Library/Application Support/studio.techflow.badgeify' && trash $LOGGED_IN_USER '~/Library/Caches/studio.techflow.badgeify' && trash $LOGGED_IN_USER '~/Library/Logs/studio.techflow.badgeify' && trash $LOGGED_IN_USER '~/Library/Preferences/studio.techflow.badgeify.plist' && trash $LOGGED_IN_USER '~/Library/WebKit/studio.techflow.badgeify'",
