]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'org.videolan.vlc' && sudo rm -rf \"$APPDIR/VLC.app\" && trash $LOGGED_IN_USER '~/Library/Application Support/com.apple.sharedfilelist/com.apple.LSSharedFileList.ApplicationRecentDocuments/org.videolan.vlc.sfl*' && trash $LOGGED_IN_USER '~/Library/Application Support/org.videolan.vlc' && trash $LOGGED_IN_USER '~/Library/Application Support/VLC' && trash $LOGGED_IN_USER '~/Library/Caches/org.videolan.vlc' && trash $LOGGED_IN_USER '~/Library/HTTPStorages/org.videolan.vlc' && trash $LOGGED_IN_USER '~/Library/Preferences/org.videolan.vlc' && trash $LOGGED_IN_USER '~/Library/Preferences/org.videolan.vlc.plist' && trash $LOGGED_IN_USER '~/Library/Saved Application State/org.videolan.vlc.savedState'",
