        "uninstallScript": "APPDIR=\"/Applications/\" && LOGGED_IN_USER=$(scutil <<< \"show State:/Users/ConsoleUser\" | awk '/Name :/ { print $3 }') && trash() { local logged_in_user=\"$1\"; local target_file=\"$2\"; local timestamp=\"$(date +%Y-%m-%d-%s)\"; local rand=\"$(jot -r 1 0 99999)\"; if [[ \"$target_file\" == ~* ]]; then target_file=\"/Users/$logged_in_user${target_file:1}\"; fi; local trash=\"/Users/$logged_in_user/.Trash\"; if [[ \"$target_file\" == *[*?[]* ]]; then local file file_name; local matched=false; local i=0; while IFS= read -r file; do [[ -n \"$file\" ]] || continue; [[ -e \"$file\" || -L \"$file\" ]] || continue; matched=true; i=$((i + 1)); file_name=\"$(basename \"$file\")\"; echo \"removing $file.\"; mv -f \"$file\" \"$trash/${file_name}_${timestamp}_${rand}_${i}\"; done < <(compgen -G \"$target_file\" 2>/dev/null) if [[ \"$matched\" == false ]]; then echo \"$target_file doesn't exist.\"; fi; return fi; local file_name=\"$(basename \"${target_file}\")\"; if [[ -e \"$target_file\" ]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && sudo rm -rf \"$APPDIR/qView.app\" && trash $LOGGED_IN_USER '~/Library/Application Support/com.apple.sharedfilelist/com.apple.LSSharedFileList.ApplicationRecentDocuments/com.interversehq.qview.sfl*' && trash $LOGGED_IN_USER '~/Library/Preferences/com.interversehq.qView.plist' && trash $LOGGED_IN_USER '~/Library/Preferences/com.qview.qView.plist' && trash $LOGGED_IN_USER '~/Library/Saved Application State/com.interversehq.qView.savedState'",
