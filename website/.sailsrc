      {
        "url": "/case-study/hawx",
        "title": "Hawx",
        "lastModifiedAt": 1785377003000,
        "htmlId": "articles--hawx--725887b7b6",
        "sectionRelativeRepoPath": "hawx.md",
        "meta": {
          "category": "case study",
          "articleTitle": "How Hawx gets field technicians productive on hour one with Fleet",
          "description": "Hawx automated seasonal iOS onboarding and offboarding with Fleet, Tines, and Okta, eliminating start-of-season helpdesk floods in one month.",
          "publishedOn": "2026-07-29",
          "authorGitHubUsername": "n/a",
          "authorFullName": "Fleetdm",
          "companyLogoFilename": "hawx-logo-150x40@2x.png",
          "quoteAuthorImageFilename": "loren-farr-120x120@2x.png",
          "quoteAuthorName": "Loren Farr",
          "quoteAuthorJobTitle": "IT Manager, Hawx",
          "quoteContent": "“The slam dunk for us was that Fleet gave us control over the phone itself. We can run the device the way we want. Nobody else we looked at could offer that.”",
          "companyName": "Hawx",
          "companyInfo": "Hawx Pest Control provides residential and commercial pest control across more than a dozen states. Its model is built on prevention and consistency, backed by a technology-first approach, designed to keep homeowners informed about exactly what's happening at their property.",
          "companyInfoLineTwo": "A three-person IT team manages roughly 500 iOS devices in Fleet's managed cloud, supporting a field technician workforce that expands sharply every summer.",
          "summaryChallenge": "Hawx hires droves of contract pest control technicians every summer, and a technician who can't get their phone provisioned can't be dispatched. With Jamf, phones were stuck on the MDM screen until the technician logged in, and nobody remembered their credentials, flooding the helpdesk. Identifying which device belonged to which technician took five to ten minutes per call.",
          "summarySolution": "Fleet gives Hawx direct, programmatic control over every device through its API. Paired with Tines and Okta, Fleet automates onboarding and offboarding end to end, moving a technician's device into the right fleet with the correct profiles, policies, and apps the moment they verify their identity.",
          "summaryKeyResults": "New technicians productive from hour one during peak hiring season; Onboarding and offboarding that run automatically, wiping or locking devices based on role; Up to ten minutes saved on every support call, with device and user identification down to seconds; A full migration off Jamf completed in one month"
        }
      },
