]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'com.apptorium.SideNotes-paddle' && sudo rm -rf \"$APPDIR/SideNotes.app\" && trash $LOGGED_IN_USER '~/Library/Application Scripts/com.apptorium.SideNotes' && trash $LOGGED_IN_USER '~/Library/Application Scripts/com.apptorium.SideNotes-paddle*.ShareExtension--Paddle-' && trash $LOGGED_IN_USER '~/Library/Application Scripts/com.apptorium.SideNotes-paddle.Widgets' && trash $LOGGED_IN_USER '~/Library/Application Scripts/com.apptorium.SideNotes.ShareExtension' && trash $LOGGED_IN_USER '~/Library/Application Support/com.apptorium.SideNotes-paddle' && trash $LOGGED_IN_USER '~/Library/Application Support/SideNotes' && trash $LOGGED_IN_USER '~/Library/Caches/com.apptorium.SideNotes-paddle' && trash $LOGGED_IN_USER '~/Library/Containers/com.apptorium.SideNotes-paddle.ShareExtension--Paddle-' && trash $LOGGED_IN_USER '~/Library/Containers/com.apptorium.SideNotes-paddle.Widgets' && trash $LOGGED_IN_USER '~/Library/HTTPStorages/com.apptorium.SideNotes-paddle*' && trash $LOGGED_IN_USER '~/Library/Preferences/com.apptorium.SideNotes-paddle.plist' && trash $LOGGED_IN_USER '~/Library/WebKit/com.apptorium.SideNotes-paddle'",
