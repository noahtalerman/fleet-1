]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'org.safeexambrowser.SafeExamBrowser' && sudo rm -rf \"$APPDIR/Safe Exam Browser.app\" && trash $LOGGED_IN_USER '~/Library/Caches/org.safeexambrowser.SafeExamBrowser' && trash $LOGGED_IN_USER '~/Library/Logs/Safe Exam Browser' && trash $LOGGED_IN_USER '~/Library/Preferences/org.safeexambrowser.SafeExamBrowser.plist' && trash $LOGGED_IN_USER '~/Library/WebKit/org.safeexambrowser.SafeExamBrowser'",
        "version": "3.7.1.1"
      },
      {
        "name": "Santa",
