      {
        "name": "Get users with secure token",
        "platform": "darwin",
        "description": "Lists local user accounts (UID 501 and above) and indicates whether each has a secure token, which is required for FileVault access on macOS.",
        "query": "SELECT\n  u.uid,\n  u.username,\n  CASE WHEN fu.uuid IS NOT NULL THEN 1 ELSE 0 END AS has_secure_token\nFROM users u\nLEFT JOIN filevault_users fu ON fu.uuid = u.uuid\nWHERE u.uid >= 501;",
        "purpose": "Informational",
        "tags": [
          "filevault",
          "users"
        ],
        "contributors": [
