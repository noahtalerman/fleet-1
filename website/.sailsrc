]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'com.obsproject.obs-studio' && sudo rm -rf '/Library/CoreMediaIO/Plug-Ins/DAL/obs-mac-virtualcam.plugin' && sudo rm -rf \"$APPDIR/OBS.app\" && trash $LOGGED_IN_USER '~/Library/Application Support/obs-studio' && trash $LOGGED_IN_USER '~/Library/HTTPStorages/com.obsproject.obs-studio' && trash $LOGGED_IN_USER '~/Library/Preferences/com.obsproject.obs-studio.plist' && trash $LOGGED_IN_USER '~/Library/Saved Application State/com.obsproject.obs-studio.savedState'",
