        "outputSlug": "openvpn-connect/darwin",
        "bundleIdentifier": "org.openvpn.client.app",
        "description": "OpenVPN Connect is a VPN client that provides secure remote access to networks and services.",
        "platform": "darwin",
        "lineNumberInJson": 6487,
