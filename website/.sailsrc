_file doesn't exist.\"; fi; return fi; local file_name=\"$(basename \"${target_file}\")\"; if [[ -e \"$target_file\" ]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && send_signal 'TERM' 'com.dbeaver.product.enterprise' \"$LOGGED_IN_USER\" && sudo rm -rf \"$APPDIR/DBeaverEE.app\" && trash $LOGGED_IN_USER '~/Library/DBeaverData' && trash $LOGGED_IN_USER '~/Library/Preferences/com.dbeaver.product.enterprise.plist' && trash $LOGGED_IN_USER '~/Library/Saved Application State/com.dbeaver.product.enterprise.savedState'",
        "version": "26.2.0"
