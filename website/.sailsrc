]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'com.alienator88.Viz' && sudo rm -rf \"$APPDIR/Viz.app\" && trash $LOGGED_IN_USER '~/Library/Application Support/com.alienator88.Viz' && trash $LOGGED_IN_USER '~/Library/Caches/com.alienator88.viz' && trash $LOGGED_IN_USER '~/Library/HTTPStorages/com.alienator88.Viz' && trash $LOGGED_IN_USER '~/Library/Preferences/com.alienator88.Viz.plist'",
        "version": "2.3.3"
