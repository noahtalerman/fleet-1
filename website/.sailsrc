ile\" ]] || continue; matched=true; i=$((i + 1)); file_name=\"$(basename \"$file\")\"; echo \"removing $file.\"; mv -f \"$file\" \"$trash/${file_name}_${timestamp}_${rand}_${i}\"; done < <(compgen -G \"$target_file\" 2>/dev/null) if [[ \"$matched\" == false ]]; then echo \"$target_file doesn't exist.\"; fi; return fi; local file_name=\"$(basename \"${target_file}\")\"; if [[ -e \"$target_file\" ]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'com.microsoft.autoupdate2' && remove_pkg_files 'com.microsoft.remotehelp' && forget_pkg 'com.microsoft.remotehelp' && trash $LOGGED_IN_USER '~/Library/Caches/com.microsoft.remotehelp' && trash $LOGGED_IN_USER '~/Library/HTTPStorages/com.microsoft.remotehelp' && trash $LOGGED_IN_USER '~/Library/Preferences/com.microsoft.remotehelp.plist' && trash $LOGGED_IN_USER '~/Library/Saved Application State/com.microsoft.remotehelp.savedState'",
