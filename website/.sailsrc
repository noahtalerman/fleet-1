]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'com.LightBurnSoftware.LightBurn' && sudo rm -rf \"$APPDIR/LightBurn.app\" && trash $LOGGED_IN_USER '~/Library/Preferences/com.LightBurnSoftware.LightBurn.plist' && trash $LOGGED_IN_USER '~/Library/Preferences/LightBurn' && trash $LOGGED_IN_USER '~/Library/Saved Application State/com.LightBurnSoftware.LightBurn.savedState'",
