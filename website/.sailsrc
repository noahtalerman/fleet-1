            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          },
          {
            "name": "ipv6_local_network",
            "description": "True if any interface is connected to a routed network via IPv6",
            "type": "integer",
            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          },
          {
            "name": "ipv6_internet",
