]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'com.jetbrains.WebStorm' && sudo rm -rf \"$APPDIR/WebStorm.app\" && trash $LOGGED_IN_USER '~/Library/Application Support/JetBrains/WebStorm2026.2' && trash $LOGGED_IN_USER '~/Library/Caches/com.apple.nsurlsessiond/Downloads/com.jetbrains.WebStorm' && trash $LOGGED_IN_USER '~/Library/Caches/JetBrains/WebStorm2026.2' && trash $LOGGED_IN_USER '~/Library/Logs/JetBrains/WebStorm2026.2' && trash $LOGGED_IN_USER '~/Library/Preferences/com.jetbrains.WebStorm.plist' && trash $LOGGED_IN_USER '~/Library/Preferences/jetbrains.webstorm.*.plist' && trash $LOGGED_IN_USER '~/Library/Preferences/WebStorm2026.2' && trash $LOGGED_IN_USER '~/Library/Preferences/webstorm.plist' && trash $LOGGED_IN_USER '~/Library/Saved Application State/com.jetbrains.WebStorm.savedState'",
