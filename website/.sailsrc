]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'io.rancherdesktop.app' && sudo rm -rf '/opt/rancher-desktop' && sudo rm -rf '/private/etc/sudoers.d/zzzzz-rancher-desktop-lima' && sudo rm -rf '/private/var/run/docker.sock' && sudo rm -rf '/private/var/run/rancher-desktop-*' && sudo rm -rf \"$APPDIR/Rancher Desktop.app\" && trash $LOGGED_IN_USER '~/.kuberlr' && trash $LOGGED_IN_USER '~/.rd' && trash $LOGGED_IN_USER '~/Library/Application Support/Caches/rancher-desktop-updater' && trash $LOGGED_IN_USER '~/Library/Application Support/Rancher Desktop' && trash $LOGGED_IN_USER '~/Library/Application Support/rancher-desktop' && trash $LOGGED_IN_USER '~/Library/Caches/io.rancherdesktop.app*' && trash $LOGGED_IN_USER '~/Library/Caches/rancher-desktop' && trash $LOGGED_IN_USER '~/Library/Logs/rancher-desktop' && trash $LOGGED_IN_USER '~/Library/Preferences/ByHost/io.rancherdesktop.app*' && trash $LOGGED_IN_USER '~/Library/Preferences/io.rancherdesktop.app.plist' && trash $LOGGED_IN_USER '~/Library/Preferences/rancher-desktop' && trash $LOGGED_IN_USER '~/Library/Saved Application State/io.rancherdesktop.app.savedState'",
