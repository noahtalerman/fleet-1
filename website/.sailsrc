-f -- \"$path\"; fi; fi; done done done } && remove_pkg_files() { local PKGID=\"$1\"; expand_pkgid_and_map \"$PKGID\" remove_receipt_files } && remove_receipt_files() { local PKGID=\"$1\"; local PKGINFO VOLUME INSTALL_LOCATION FULL_INSTALL_LOCATION; echo \"pkgutil --pkg-info-plist \\\"$PKGID\\\"\"; PKGINFO=$(pkgutil --pkg-info-plist \"$PKGID\"); VOLUME=$(echo \"$PKGINFO\" | awk '/<key>volume<\\/key>/ {getline; gsub(/.*<string>|<\\/string>.*/, \"\"); print}'); INSTALL_LOCATION=$(echo \"$PKGINFO\" | awk '/<key>install-location<\\/key>/ {getline; gsub(/.*<string>|<\\/string>.*/, \"\"); print}'); if [ -z \"$INSTALL_LOCATION\" ] || [ \"$INSTALL_LOCATION\" = \"/\" ]; then FULL_INSTALL_LOCATION=\"$VOLUME\"; else FULL_INSTALL_LOCATION=\"$VOLUME/$INSTALL_LOCATION\"; FULL_INSTALL_LOCATION=$(echo \"$FULL_INSTALL_LOCATION\" | sed 's|//|/|g'); fi; echo \"sudo pkgutil --only-files --files \\\"$PKGID\\\" | sed \\\"s|^|${FULL_INSTALL_LOCATION}/|\\\" | tr '\\\\\\\\n' '\\\\\\\\0' | /usr/bin/sudo -u root -E -- /usr/bin/xargs -0 -- /bin/rm -rf\"; sudo pkgutil --only-files --files \"$PKGID\" | sed \"s|^|/${INSTALL_LOCATION}/|\" | tr '\\n' '\\0' | /usr/bin/sudo -u root -E -- /usr/bin/xargs -0 -- /bin/rm -rf; echo \"sudo pkgutil --only-dirs --files \\\"$PKGID\\\" | sed \\\"s|^|${FULL_INSTALL_LOCATION}/|\\\" | grep '\\\\.app$' | tr '\\\\\\\\n' '\\\\\\\\0' | /usr/bin/sudo -u root -E -- /usr/bin/xargs -0 -- /bin/rm -rf\"; sudo pkgutil --only-dirs --files \"$PKGID\" | sed \"s|^|${FULL_INSTALL_LOCATION}/|\" | grep '\\.app$' | tr '\\n' '\\0' | /usr/bin/sudo -u root -E -- /usr/bin/xargs -0 -- /bin/rm -rf; root_app_dir=$(; sudo pkgutil --only-dirs --files \"$PKGID\" \\; | sed \"s|^|${FULL_INSTALL_LOCATION}/|\" \\; | grep 'Applications' \\; | awk '{ print length, $0 }' \\; | sort -n \\; | head -n1 \\; | cut -d' ' -f2-; ); if [ -n \"$root_app_dir\" ]; then echo \"sudo rmdir -p \\\"$root_app_dir\\\" 2>/dev/null || :\"; sudo rmdir -p \"$root_app_dir\" 2>/dev/null || :; fi } && trash() { local logged_in_user=\"$1\"; local target_file=\"$2\"; local timestamp=\"$(date +%Y-%m-%d-%s)\"; local rand=\"$(jot -r 1 0 99999)\"; if [[ \"$target_file\" == ~* ]]; then target_file=\"/Users/$logged_in_user${target_file:1}\"; fi; local trash=\"/Users/$logged_in_user/.Trash\"; if [[ \"$target_file\" == *[*?[]* ]]; then local file file_name; local matched=false; local i=0; while IFS= read -r file; do [[ -n \"$file\" ]] || continue; [[ -e \"$file\" || -L \"$file\" ]] || continue; matched=true; i=$((i + 1)); file_name=\"$(basename \"$file\")\"; echo \"removing $file.\"; mv -f \"$file\" \"$trash/${file_name}_${timestamp}_${rand}_${i}\"; done < <(compgen -G \"$target_file\" 2>/dev/null) if [[ \"$matched\" == false ]]; then echo \"$target_file doesn't exist.\"; fi; return fi; local file_name=\"$(basename \"${target_file}\")\"; if [[ -e \"$target_file\" ]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && remove_launchctl_service 'org.wireshark.ChmodBPF' && remove_pkg_files 'org.wireshark.*' && forget_pkg 'org.wireshark.*' && sudo rm -rf \"$APPDIR/Wireshark.app\" && trash $LOGGED_IN_USER '/Library/Application Support/Wireshark' && trash $LOGGED_IN_USER '~/.config/wireshark' && trash $LOGGED_IN_USER '~/Library/Caches/org.wireshark.Wireshark' && trash $LOGGED_IN_USER '~/Library/Cookies/org.wireshark.Wireshark.binarycookies' && trash $LOGGED_IN_USER '~/Library/HTTPStorages/org.wireshark.Wireshark' && trash $LOGGED_IN_USER '~/Library/HTTPStorages/org.wireshark.Wireshark.binarycookies' && trash $LOGGED_IN_USER '~/Library/Preferences/org.wireshark.Wireshark.plist' && trash $LOGGED_IN_USER '~/Library/Saved Application State/org.wireshark.Wireshark.savedState' && trash $LOGGED_IN_USER '~/Library/WebKit/org.wireshark.Wireshark'",
