]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'info.eurocomp.TimingHelper' && sudo rm -rf \"$APPDIR/Timing.app\" && trash $LOGGED_IN_USER '~/Library/Application Support/info.eurocomp.Timing2' && trash $LOGGED_IN_USER '~/Library/Application Support/info.eurocomp.TimingHelper' && trash $LOGGED_IN_USER '~/Library/Application Support/info.eurocomp.TimingHelper.InfoExtractorService' && trash $LOGGED_IN_USER '~/Library/Caches/info.eurocomp.Timing2' && trash $LOGGED_IN_USER '~/Library/Caches/info.eurocomp.TimingHelper' && trash $LOGGED_IN_USER '~/Library/Caches/info.eurocomp.TimingHelper.InfoExtractorService' && trash $LOGGED_IN_USER '~/Library/Preferences/info.eurocomp.Timing2.plist' && trash $LOGGED_IN_USER '~/Library/Preferences/info.eurocomp.TimingHelper.InfoExtractorService.plist' && trash $LOGGED_IN_USER '~/Library/Preferences/info.eurocomp.TimingHelper.plist'",
