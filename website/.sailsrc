]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'com.eltima.Airy' && sudo rm -rf \"$APPDIR/Airy.app\" && trash $LOGGED_IN_USER '~/Library/Preferences/com.eltima.Airy.plist'",
