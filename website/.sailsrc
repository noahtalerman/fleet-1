]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'org.stellarium.Stellarium' && sudo rm -rf \"$APPDIR/Stellarium.app\" && trash $LOGGED_IN_USER '~/Library/Application Support/Stellarium' && trash $LOGGED_IN_USER '~/Library/Preferences/Stellarium'",
