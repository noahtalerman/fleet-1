]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'com.solotuna.devknife' && sudo rm -rf \"$APPDIR/DevKnife.app\" && trash $LOGGED_IN_USER '~/Library/Application Support/com.solotuna.devknife' && trash $LOGGED_IN_USER '~/Library/Application Support/DevKnife' && trash $LOGGED_IN_USER '~/Library/Preferences/com.solotuna.devknife.plist'",
