]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'com.kagi.kagimacOS' && sudo rm -rf \"$APPDIR/Orion.app\" && trash $LOGGED_IN_USER '~/Library/Application Scripts/com.kagi.kagimacOS.ShareExtension' && trash $LOGGED_IN_USER '~/Library/Application Support/Orion' && trash $LOGGED_IN_USER '~/Library/Caches/com.kagi.kagimacOS' && trash $LOGGED_IN_USER '~/Library/Caches/com.kagi.kagimacOS.IconService' && trash $LOGGED_IN_USER '~/Library/Containers/com.kagi.kagimacOS.ShareExtension' && trash $LOGGED_IN_USER '~/Library/HTTPStorages/com.kagi.kagimacOS*' && trash $LOGGED_IN_USER '~/Library/Preferences/com.kagi.kagimacOS.plist' && trash $LOGGED_IN_USER '~/Library/WebKit/com.kagi.kagimacOS'",
