]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'Fathom Helper' && quit_application 'Fathom' && sudo rm -rf \"$APPDIR/Fathom.app\" && trash $LOGGED_IN_USER '~/Library/Application Support/com.apple.sharedfilelist/com.apple.LSSharedFileList.ApplicationRecentDocuments/video.fathom.electron.sfl*' && trash $LOGGED_IN_USER '~/Library/Application Support/Fathom' && trash $LOGGED_IN_USER '~/Library/Caches/video.fathom.electron*' && trash $LOGGED_IN_USER '~/Library/HTTPStorages/video.fathom.electron' && trash $LOGGED_IN_USER '~/Library/Logs/Fathom' && trash $LOGGED_IN_USER '~/Library/Preferences/video.fathom.electron.plist'",
