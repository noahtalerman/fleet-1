]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application '86Z3GCJ4MF.com.noodlesoft.HazelHelper' && sudo rm -rf \"$APPDIR/Hazel.app\" && trash $LOGGED_IN_USER '~/Library/Application Support/Hazel' && trash $LOGGED_IN_USER '~/Library/Caches/com.noodlesoft.HazelHelper' && trash $LOGGED_IN_USER '~/Library/Logs/Hazel' && trash $LOGGED_IN_USER '~/Library/Preferences/86Z3GCJ4MF.com.noodlesoft.HazelHelper.plist' && trash $LOGGED_IN_USER '~/Library/Preferences/com.noodlesoft.Hazel.plist' && trash $LOGGED_IN_USER '~/Library/Preferences/com.noodlesoft.HazelHelper.plist' && trash $LOGGED_IN_USER '~/Library/Saved Application State/com.noodlesoft.Hazel.savedState'",
