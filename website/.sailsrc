]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'com.kairos.duetMac' && sudo rm -rf \"$APPDIR/duet.app\" && sudo rmdir '~/Library/Caches/com.crashlytics.data' && sudo rmdir '~/Library/Caches/io.fabric.sdk.mac.data' && trash $LOGGED_IN_USER '~/Library/Application Support/com.kairos.duet*' && trash $LOGGED_IN_USER '~/Library/Caches/com.crashlytics.data/com.kairos.duet*' && trash $LOGGED_IN_USER '~/Library/Caches/com.kairos.duet*' && trash $LOGGED_IN_USER '~/Library/Caches/io.fabric.sdk.mac.data/com.kairos.duet*' && trash $LOGGED_IN_USER '~/Library/Caches/SentryCrash/duet' && trash $LOGGED_IN_USER '~/Library/HTTPStorages/com.kairos.duet*' && trash $LOGGED_IN_USER '~/Library/Preferences/com.kairos.duet*.plist'",
