]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'com.DigiDNA.iMazingProfileEditorMac' && sudo rm -rf \"$APPDIR/iMazing Profile Editor.app\" && trash $LOGGED_IN_USER '~/Library/Application Scripts/com.DigiDNA.iMazingProfileEditorMac' && trash $LOGGED_IN_USER '~/Library/Caches/com.plausiblelabs.crashreporter.data/com.DigiDNA.iMazingProfileEditorMac.Mini' && trash $LOGGED_IN_USER '~/Library/Containers/com.DigiDNA.iMazingProfileEditorMac' && trash $LOGGED_IN_USER '~/Library/Saved Application State/com.DigiDNA.iMazingProfileEditorMac.savedState'",
        "version": "2.3.1"
