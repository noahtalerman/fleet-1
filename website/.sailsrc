_file doesn't exist.\"; fi; return fi; local file_name=\"$(basename \"${target_file}\")\"; if [[ -e \"$target_file\" ]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && send_signal 'TERM' 'com.boostio.boostnote' \"$LOGGED_IN_USER\" && sudo rm -rf \"$APPDIR/Boost Note.app\" && trash $LOGGED_IN_USER '~/Library/Application Support/Boost Note' && trash $LOGGED_IN_USER '~/Library/Preferences/com.boostio.boostnote.plist' && trash $LOGGED_IN_USER '~/Library/Saved Application State/com.boostio.boostnote.savedState'",
