 \"true\" ]]; then sudo launchctl remove \"${service_label}\"; else launchctl remove \"${service_label}\"; fi; sleep 1; fi; paths=(; \"/Library/LaunchAgents/${service_label}.plist\"; \"/Library/LaunchDaemons/${service_label}.plist\"; ); if [[ $should_sudo == \"false\" ]]; then for i in \"${!paths[@]}\"; do paths[i]=\"${HOME}${paths[i]}\"; done fi; for path in \"${paths[@]}\"; do if [[ -e \"$path\" ]]; then if [[ $should_sudo == \"true\" ]]; then sudo rm -f -- \"$path\"; else rm -f -- \"$path\"; fi; fi; done done done } && trash() { local logged_in_user=\"$1\"; local target_file=\"$2\"; local timestamp=\"$(date +%Y-%m-%d-%s)\"; local rand=\"$(jot -r 1 0 99999)\"; if [[ \"$target_file\" == ~* ]]; then target_file=\"/Users/$logged_in_user${target_file:1}\"; fi; local trash=\"/Users/$logged_in_user/.Trash\"; if [[ \"$target_file\" == *[*?[]* ]]; then local file file_name; local matched=false; local i=0; while IFS= read -r file; do [[ -n \"$file\" ]] || continue; [[ -e \"$file\" || -L \"$file\" ]] || continue; matched=true; i=$((i + 1)); file_name=\"$(basename \"$file\")\"; echo \"removing $file.\"; mv -f \"$file\" \"$trash/${file_name}_${timestamp}_${rand}_${i}\"; done < <(compgen -G \"$target_file\" 2>/dev/null) if [[ \"$matched\" == false ]]; then echo \"$target_file doesn't exist.\"; fi; return fi; local file_name=\"$(basename \"${target_file}\")\"; if [[ -e \"$target_file\" ]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && remove_launchctl_service 'net.whatroute.LaunchHelper' && remove_launchctl_service 'net.whatroute.whatroute2helper' && quit_application 'net.whatroute.whatroute2' && sudo rm -rf '/Library/PrivilegedHelperTools/net.whatroute.whatroute2helper' && sudo rm -rf \"$APPDIR/WhatRoute.app\" && trash $LOGGED_IN_USER '~/Library/Caches/net.whatroute.whatroute2' && trash $LOGGED_IN_USER '~/Library/Logs/net.whatroute.whatroute2' && trash $LOGGED_IN_USER '~/Library/Preferences/net.whatroute.whatroute2.plist'",
        "version": "2.8.2"
