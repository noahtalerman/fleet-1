            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          },
          {
            "name": "noise",
            "description": "The current noise measurement (dBm)",
            "type": "integer",
            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          },
          {
