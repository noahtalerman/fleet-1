      {
        "name": "MITRE - Kernel Module Activity",
        "platform": "linux",
        "description": "Detect loading, unloading, and manipulating modules on Linux systems - ATT&CK T1215",
        "query": "SELECT usr.username, sht.command, sht.history_file FROM shell_history sht\nJOIN users usr ON sht.uid = usr.uid WHERE sht.uid IN (SELECT uid FROM users) AND\n(sht.command LIKE '%modprobe%' OR sht.command LIKE '%insmod%' OR sht.command LIKE\n'%lsmod%' OR sht.command LIKE '%rmmod%' OR sht.command LIKE '%modinfo%'\nOR sht.command LIKE '%linux-headers-$%' OR sht.command LIKE '%kernel-devel-$%');",
        "purpose": "Detection",
        "tags": [
          "mitre",
          "att&ck",
          "threat detection"
