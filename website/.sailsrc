w4u92.ShipIt.*.plist' && trash $LOGGED_IN_USER '~/Library/Preferences/com.todesktop.230313mzl4w4u92.plist' && trash $LOGGED_IN_USER '~/Library/Saved Application State/com.todesktop.230313mzl4w4u92.savedState' && trash $LOGGED_IN_USER '~/Library/Saved Application State/todesktop.com.ToDesktop-Installer.savedState'",
        "version": "3.26.13"
