            "type": "text",
            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          },
          {
            "name": "size",
            "description": "Size of compiled table data",
            "type": "integer",
            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          },
          {
            "name": "md5",
            "description": "MD5 hash of table content",
            "type": "text",
            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
