rary/HTTPStorages/com.microsoft.autoupdate2' && trash $LOGGED_IN_USER '~/Library/Preferences/com.microsoft.autoupdate.fba.plist' && trash $LOGGED_IN_USER '~/Library/Preferences/com.microsoft.autoupdate2.plist' && trash $LOGGED_IN_USER '~/Library/Preferences/com.microsoft.shared.plist' && trash $LOGGED_IN_USER '~/Library/Saved Application State/com.microsoft.autoupdate2.savedState'",
