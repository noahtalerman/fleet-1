      {
        "name": "puppet_logs",
        "notes": "This table is from the [Mac Admins osquery extension](https://github.com/macadmins/osquery-extension).",
        "description": "Outputs [Puppet](https://puppet.com/) logs from the last run.",
        "platforms": [
