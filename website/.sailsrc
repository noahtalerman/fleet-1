      {
        "name": "Get CrowdStrike sensor status",
        "platform": "darwin, linux, windows",
        "description": "Reports whether the CrowdStrike sensor is running on each host by looking for its processes (com.crowdstrike.falcon.Agent or falcond on macOS, falcon-sensor on Linux, CSFalconService on Windows). Hosts that report \"no\" have no sensor running.",
        "query": "SELECT\n  CASE WHEN COUNT(*) > 0 THEN 'yes' ELSE 'no' END AS crowdstrike_running,\n  GROUP_CONCAT(DISTINCT name) AS sensor_processes\nFROM processes\nWHERE name IN ('com.crowdstrike.falcon.Agent', 'falcond', 'falcon-sensor', 'falcon-sensor-bpf', 'CSFalconService.exe', 'CSFalconContainer.exe');\n",
        "purpose": "Informational",
        "tags": [
          "compliance",
          "inventory",
          "crowdstrike"
        ],
        "contributors": [
          {
            "name": "allenhouchins",
            "handle": "allenhouchins",
            "avatarUrl": "https://placekitten.com/200/200",
            "htmlUrl": "https://github.com/allenhouchins"
          }
        ],
        "kind": "query",
        "slug": "get-crowd-strike-sensor-status",
        "lineNumberInYaml": 3026
      },
      {
        "name": "Get SCCM client status",
        "platform": "windows",
        "description": "Reports whether the Microsoft Configuration Manager (SCCM) client is running on each host by checking the SMS Agent Host service (CcmExec). Returns \"yes\" when the service is running, \"no\" when it is installed but stopped, and \"not installed\" when the service is missing.",
        "query": "SELECT\n  CASE\n    WHEN s.status = 'RUNNING' THEN 'yes'\n    WHEN s.status IS NULL THEN 'not installed'\n    ELSE 'no'\n  END AS sccm_client_running,\n  s.display_name,\n  s.status AS service_status,\n  s.start_type,\n  s.path\nFROM (SELECT 1) LEFT JOIN services s ON s.name = 'CcmExec';\n",
        "purpose": "Informational",
        "tags": [
          "compliance",
          "inventory",
          "sccm"
        ],
        "contributors": [
