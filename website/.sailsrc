]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'com.sonos.macController2' && sudo rm -rf \"$APPDIR/Sonos.app\" && trash $LOGGED_IN_USER '~/Library/Application Support/CrashReporter/Sonos_*.plist' && trash $LOGGED_IN_USER '~/Library/Application Support/SonosV2' && trash $LOGGED_IN_USER '~/Library/Caches/com.sonos.macController2' && trash $LOGGED_IN_USER '~/Library/HTTPStorages/com.sonos.macController2' && trash $LOGGED_IN_USER '~/Library/Logs/Sonos*' && trash $LOGGED_IN_USER '~/Library/Preferences/com.sonos.macController2.plist'",
