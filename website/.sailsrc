]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'DeskTime' && sudo rm -rf \"$APPDIR/DeskTime.app\" && trash $LOGGED_IN_USER '~/Library/Application Support/DeskTime' && trash $LOGGED_IN_USER '~/Library/Logs/DeskTime' && trash $LOGGED_IN_USER '~/Library/Preferences/com.desktime.DeskTime.plist'",
