        ],
        "evented": false,
        "cacheable": false,
        "notes": "",
        "examples": "Identify Yubikeys currently connected. The model field contains information\nabout what authentication protocols the keys are configured to support. This\ntable can be used to track any type of USB device.\n\n```\nSELECT model, vendor, version FROM usb_devices WHERE vendor='Yubico';\n```",
        "columns": [
          {
            "name": "usb_address",
            "description": "USB Device used address",
            "type": "integer",
