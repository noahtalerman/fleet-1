]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'com.HairerSoft.AmadeusPro3' && sudo rm -rf \"$APPDIR/Amadeus Pro 3.app\" && trash $LOGGED_IN_USER '~/Library/Application Support/Amadeus Pro' && trash $LOGGED_IN_USER '~/Library/Caches/com.HairerSoft.AmadeusPro' && trash $LOGGED_IN_USER '~/Library/HTTPStorages/com.HairerSoft.AmadeusPro' && trash $LOGGED_IN_USER '~/Library/Preferences/com.HairerSoft.AmadeusPro.plist' && trash $LOGGED_IN_USER '~/Library/Saved Application State/com.HairerSoft.AmadeusPro.savedState'",
