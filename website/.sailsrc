      {
        "name": "NeoFinder",
        "identifier": "neofinder-darwin",
        "outputSlug": "neofinder/darwin",
        "bundleIdentifier": "de.wfs-apps.neofinder",
        "description": "NeoFinder is a digital media asset manager.",
        "platform": "darwin",
        "lineNumberInJson": 5969,
