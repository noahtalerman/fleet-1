            "description": "Path to the ssh_config file",
            "type": "text",
            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          }
        ],
        "fleetRepoUrl": "https://github.com/fleetdm/fleet/blob/main/schema/tables/ssh_configs.yml"
