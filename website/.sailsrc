]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'com.gonitro.NitroPDFPro' && sudo rm -rf \"$APPDIR/Nitro PDF Pro.app\" && trash $LOGGED_IN_USER '~/Library/Application Scripts/com.gonitro.NitroPDFPro' && trash $LOGGED_IN_USER '~/Library/Application Support/com.apple.sharedfilelist/com.apple.LSSharedFileList.ApplicationRecentDocuments/com.gonitro.nitropdfpro.sfl*' && trash $LOGGED_IN_USER '~/Library/Containers/com.gonitro.NitroPDFPro'",
