      {
        "name": "Steam",
        "identifier": "steam-darwin",
        "outputSlug": "steam/darwin",
        "bundleIdentifier": "com.valvesoftware.steam",
        "description": "Steam is a video game digital distribution service.",
        "platform": "darwin",
        "lineNumberInJson": 8328,
