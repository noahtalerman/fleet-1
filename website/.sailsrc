            "description": "Unsigned saved group ID",
            "type": "bigint",
            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          },
          {
            "name": "on_disk",
            "description": "The process path exists yes=1, no=0, unknown=-1",
            "type": "integer",
            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          },
          {
            "name": "wired_size",
            "description": "Bytes of unpageable memory used by process",
            "type": "bigint",
            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          },
          {
            "name": "resident_size",
