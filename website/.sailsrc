get_pkg 'com.tableausoftware.FLEXNet.11.*' && remove_pkg_files 'com.tableausoftware.Maestro.app' && forget_pkg 'com.tableausoftware.Maestro.app' && remove_pkg_files 'com.tableausoftware.oracle' && forget_pkg 'com.tableausoftware.oracle' && remove_pkg_files 'com.tableausoftware.postgresql' && forget_pkg 'com.tableausoftware.postgresql' && remove_pkg_files 'com.tableausoftware.telemetry' && forget_pkg 'com.tableausoftware.telemetry' && remove_pkg_files 'simba.sparkodbc' && forget_pkg 'simba.sparkodbc' && sudo rm -rf '/Library/Application Support/Tableau Prep Builder' && sudo rm -rf '/Library/Preferences/FLEXnet Publisher' && trash $LOGGED_IN_USER '~/Documents/My Tableau Prep Repository' && trash $LOGGED_IN_USER '~/Library/Application Support/Tableau Prep Builder 2026.2.3' && trash $LOGGED_IN_USER '~/Library/Caches/com.tableau.caching' && trash $LOGGED_IN_USER '~/Library/Preferences/com.tableau.Tableau-Prep-tableau-2026-2.plist' && trash $LOGGED_IN_USER '~/Library/Preferences/com.tableausoftware.tableauprep.plist' && trash $LOGGED_IN_USER '~/Library/Preferences/com.tableausoftware.tabminerva.plist' && trash $LOGGED_IN_USER '~/Library/Saved Application State/com.tableausoftware.tableauprep.savedState' && trash $LOGGED_IN_USER '~/Library/Tableau'",
