]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'com.oskarkwasniewski.MiniSim' && sudo rm -rf \"$APPDIR/MiniSim.app\" && trash $LOGGED_IN_USER '~/Library/HTTPStorages/com.oskarkwasniewski.MiniSim' && trash $LOGGED_IN_USER '~/Library/Preferences/com.oskarkwasniewski.MiniSim.plist'",
