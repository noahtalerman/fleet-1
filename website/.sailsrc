            "type": "text",
            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          },
          {
            "name": "history_file",
            "description": "Path to the .*_history for this user",
            "type": "text",
            "notes": "",
            "hidden": false,
            "required": false,
            "index": false
          }
        ],
        "fleetRepoUrl": "https://github.com/fleetdm/fleet/blob/main/schema/tables/shell_history.yml"
      },
