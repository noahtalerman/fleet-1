ntainers/com.klokki-launcher' && trash $LOGGED_IN_USER '~/Library/HTTPStorages/com.klokki.macos' && trash $LOGGED_IN_USER '~/Library/HTTPStorages/com.klokki.macos.binarycookies' && trash $LOGGED_IN_USER '~/Library/Preferences/com.klokki.macos.plist'",
