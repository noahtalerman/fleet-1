file=\"$2\"; local timestamp=\"$(date +%Y-%m-%d-%s)\"; local rand=\"$(jot -r 1 0 99999)\"; if [[ \"$target_file\" == ~* ]]; then target_file=\"/Users/$logged_in_user${target_file:1}\"; fi; local trash=\"/Users/$logged_in_user/.Trash\"; if [[ \"$target_file\" == *[*?[]* ]]; then local file file_name; local matched=false; local i=0; while IFS= read -r file; do [[ -n \"$file\" ]] || continue; [[ -e \"$file\" || -L \"$file\" ]] || continue; matched=true; i=$((i + 1)); file_name=\"$(basename \"$file\")\"; echo \"removing $file.\"; mv -f \"$file\" \"$trash/${file_name}_${timestamp}_${rand}_${i}\"; done < <(compgen -G \"$target_file\" 2>/dev/null) if [[ \"$matched\" == false ]]; then echo \"$target_file doesn't exist.\"; fi; return fi; local file_name=\"$(basename \"${target_file}\")\"; if [[ -e \"$target_file\" ]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && remove_launchctl_service 'com.citrixfiles.ens.service' && remove_pkg_files 'com.sharefile.desktop.widget' && forget_pkg 'com.sharefile.desktop.widget' && sudo rm -rf '/Applications/ShareFile.app' && trash $LOGGED_IN_USER '~/.sharefile.swp' && trash $LOGGED_IN_USER '~/Library/Application Scripts/42TZTUWV4Z.group.sharefile.desktop' && trash $LOGGED_IN_USER '~/Library/Application Scripts/com.sharefile.desktop.widget.CitrixFileProvider' && trash $LOGGED_IN_USER '~/Library/Application Scripts/RM4N8HY7K5.group.sharefile.desktop' && trash $LOGGED_IN_USER '~/Library/Application Support/com.sharefile.desktop.widget' && trash $LOGGED_IN_USER '~/Library/Application Support/ShareFileRecovery' && trash $LOGGED_IN_USER '~/Library/Caches/com.citrixfiles.ens.service' && trash $LOGGED_IN_USER '~/Library/Caches/com.sharefile.desktop.widget' && trash $LOGGED_IN_USER '~/Library/Containers/com.sharefile.desktop.widget.CitrixFileProvider' && trash $LOGGED_IN_USER '~/Library/Group Containers/42TZTUWV4Z.group.sharefile.desktop' &