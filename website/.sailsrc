]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && quit_application 'com.clipy-app.Clipy' && sudo rm -rf \"$APPDIR/Clipy.app\" && trash $LOGGED_IN_USER '~/Library/Application Support/Clipy' && trash $LOGGED_IN_USER '~/Library/Application Support/com.clipy-app.Clipy' && trash $LOGGED_IN_USER '~/Library/Caches/com.clipy-app.Clipy' && trash $LOGGED_IN_USER '~/Library/Caches/com.crashlytics.data/com.clipy-app.Clipy' && trash $LOGGED_IN_USER '~/Library/Caches/io.fabric.sdk.mac.data/com.clipy-app.Clipy' && trash $LOGGED_IN_USER '~/Library/Cookies/com.clipy-app.Clipy.binarycookies' && trash $LOGGED_IN_USER '~/Library/Preferences/com.clipy-app.Clipy.plist'",
        "version": "1.4.0"
