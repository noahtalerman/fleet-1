kgutil --only-dirs --files \"$PKGID\" | sed \"s|^|${FULL_INSTALL_LOCATION}/|\" | grep '\\.app$' | tr '\\n' '\\0' | /usr/bin/sudo -u root -E -- /usr/bin/xargs -0 -- /bin/rm -rf; root_app_dir=$(; sudo pkgutil --only-dirs --files \"$PKGID\" \\; | sed \"s|^|${FULL_INSTALL_LOCATION}/|\" \\; | grep 'Applications' \\; | awk '{ print length, $0 }' \\; | sort -n \\; | head -n1 \\; | cut -d' ' -f2-; ); if [ -n \"$root_app_dir\" ]; then echo \"sudo rmdir -p \\\"$root_app_dir\\\" 2>/dev/null || :\"; sudo rmdir -p \"$root_app_dir\" 2>/dev/null || :; fi } && trash() { local logged_in_user=\"$1\"; local target_file=\"$2\"; local timestamp=\"$(date +%Y-%m-%d-%s)\"; local rand=\"$(jot -r 1 0 99999)\"; if [[ \"$target_file\" == ~* ]]; then target_file=\"/Users/$logged_in_user${target_file:1}\"; fi; local trash=\"/Users/$logged_in_user/.Trash\"; if [[ \"$target_file\" == *[*?[]* ]]; then local file file_name; local matched=false; local i=0; while IFS= read -r file; do [[ -n \"$file\" ]] || continue; [[ -e \"$file\" || -L \"$file\" ]] || continue; matched=true; i=$((i + 1)); file_name=\"$(basename \"$file\")\"; echo \"removing $file.\"; mv -f \"$file\" \"$trash/${file_name}_${timestamp}_${rand}_${i}\"; done < <(compgen -G \"$target_file\" 2>/dev/null) if [[ \"$matched\" == false ]]; then echo \"$target_file doesn't exist.\"; fi; return fi; local file_name=\"$(basename \"${target_file}\")\"; if [[ -e \"$target_file\" ]]; then echo \"removing $target_file.\"; mv -f \"$target_file\" \"$trash/${file_name}_${timestamp}_${rand}\"; else echo \"$target_file doesn't exist.\"; fi } && remove_pkg_files 'com.company.Syncovery*' && forget_pkg 'com.company.Syncovery*' && sudo rm -rf '/Applications/Syncovery.app' && trash $LOGGED_IN_USER '~/Library/Application Support/Syncovery' && trash $LOGGED_IN_USER '~/Library/Logs/Syncovery' && trash $LOGGED_IN_USER '~/Library/Preferences/Syncovery' && trash $LOGGED_IN_USER '~/Library/Preferences/Syncovery.ini' && trash $LOGGED_IN_USER '~/Library/Saved Application State/com.company.Syncovery.savedState'",
